Algoritmo "Sequência de Fibonacci com procedimento"

Var
   N1,N2,Con: inteiro
procedimento fibonacci (var A,B:inteiro)
var c:inteiro
inicio
   c <- A + B
   escreva(C)
   A <- B
   B <- C
fimprocedimento

Inicio
   N1 <- 0
   N2 <- 1
   Escreva(N1,N2)
   para Con <- 1 ate 20 passo 1  faca
      fibonacci(N1,N2)
   fimpara
Fimalgoritmo