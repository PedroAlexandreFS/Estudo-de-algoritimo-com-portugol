Algoritmo "par ou impar com procedimento"

Var
   N: inteiro
procedimento parouimpar(V:inteiro)
inicio
      se ( V % 2 = 0) entao
         escreval("O numero ",V," é par")
      senao
           escreval("O numero ", V," é Impar")
      fimse


fimprocedimento



Inicio
      EScreval("Digite o valor: ")
      leia(N)
      parouimpar(N)


Fimalgoritmo